{
  "name": "prueba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:mobile": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "node node_modules/@nextsparkjs/core/scripts/db/run-migrations.mjs",
    "db:seed": "ts-node scripts/seed.ts",
    "build:registries": "node node_modules/@nextsparkjs/core/scripts/build/registry.mjs",
    "cy:open": "node node_modules/@nextsparkjs/core/scripts/test/cy.mjs open",
    "cy:run": "node node_modules/@nextsparkjs/core/scripts/test/cy.mjs run",
    "cy:tags": "node node_modules/@nextsparkjs/core/scripts/test/cy.mjs tags",
    "cy:run:prod": "node scripts/cy-run-prod.cjs",
    "allure:generate": "allure generate contents/themes/barbercrm/tests/cypress/allure-results --clean -o contents/themes/barbercrm/tests/cypress/allure-report",
    "allure:open": "allure open contents/themes/barbercrm/tests/cypress/allure-report"
  },
  "devDependencies": {
    "@cypress/grep": "^5.0.1",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@eslint/eslintrc": "^3.2.0",
    "@nextsparkjs/ai-workflow": "0.1.0-beta.151",
    "@nextsparkjs/testing": "latest",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/cypress": "^10.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "allure-commandline": "^2.27.0",
    "allure-cypress": "^3.0.0",
    "cypress": "15.8.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "webpack": "^5.97.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@better-fetch/fetch": "^1.1.0",
    "@hookform/resolvers": "^5.0.1",
    "@nextsparkjs/cli": "latest",
    "@nextsparkjs/core": "latest",
    "@tanstack/react-query": "^5.64.2",
    "better-auth": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.41.0",
    "jiti": "^2.0.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^16.0.0",
    "next-intl": "^4.0.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "slugify": "^1.6.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.1.5"
  }
